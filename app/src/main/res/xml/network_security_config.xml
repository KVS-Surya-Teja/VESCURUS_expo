<?xml version="1.0" encoding="utf-8"?>
<!--
    Demo scope: cleartext is broadly permitted so the Guide↔Cook LAN WebSocket
    (which uses `ws://<peer-ip>/…`) reaches its peer. Android's <domain> elements
    take hostnames, not CIDR ranges, so there is no clean way to whitelist just
    RFC1918 IPs from this file — restricting cleartext here silently killed the
    WS handshake. Production hardening is deferred to WSS + PIN pairing or the
    Nearby Connections API (see the follow-up doc).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
