<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Never upload debug camera-frame dumps to the user's Google account. -->
        <exclude domain="external" path="debug/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="external" path="debug/" />
    </device-transfer>
</data-extraction-rules>
